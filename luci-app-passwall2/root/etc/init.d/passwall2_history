#!/bin/sh /etc/rc.common

START=98
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/lua /usr/share/passwall2/history.lua collect
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Normal shutdown/restart saves the latest RAM samples before procd stops us.
	/usr/bin/lua /usr/share/passwall2/history.lua flush
}
